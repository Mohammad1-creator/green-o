# انسخ هذا الملف باسم .env.local واملأ القيم.
# لا ترفع .env.local إلى git أبداً (مستبعد تلقائياً في .gitignore).
# أي متغير يبدأ بـ NEXT_PUBLIC_ يصل إلى المتصفح، فلا تضع فيه سراً.

# البيئة: local أو dev أو prod
APP_ENV=local

# Supabase: قيم عامة تصل إلى المتصفح، وتحمي البيانات سياساتُ RLS
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase: مفتاح سري للخادم فقط (يُستخدم من المرحلة 1)
SUPABASE_SECRET_KEY=

# إشعارات Web Push (من المرحلة 2)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
PUSH_DISPATCH_SECRET=
